@@ -3875,6 +3877,48 @@ function freezeRubble(p: Piece): void {
 /** settled rubble held static (harness) */
 export function frozenRubble(): number { return frozenList.length; }
 
+/* Box3D wakes everything a destroyed body touched, and a heap is one island: a burnt-out splinter, a spent unit or a
+   faded chip going from the top of a sleeping heap woke the whole heap (the chapel's burning pile: ~1000 bodies solved
+   again for 1-2 s every few seconds). A loose piece that was asleep and lay only on things (every moving body it
+   touches is below it and asleep) leaves them exactly as they lay: after it goes they are put back to sleep. One that
+   bore or propped anything, or touched anything awake, wakes the heap as before. */
+let _qcb: ContactsBuffer | null = null, _qcon: B3Contact | null = null, _qman: Manifold | null = null;
+const _quiet: Piece[] = [];
+function quietLeaving(p: Piece): boolean {
+  _quiet.length = 0;
+  if (p.welds.length || p.rebars.length || p.ropes.length || p.mechs || p.hinged) return false;
+  if (b3.b3Body_GetType(p.body) !== b3.b3BodyType.b3_dynamicBody || b3.b3Body_IsAwake(p.body)) return false;
+  const cb = _qcb ??= b3.createContactsBuffer(), con = _qcon ??= b3.createContact(), man = _qman ??= b3.createManifold();
+  b3.getBodyContactData(cb, p.body);
+  const n = b3.getNumContacts(cb);
+  for (let i = 0; i < n; i++) {
+    b3.getContactAt(con, cb, i);
+    if (con.manifoldCount === 0) continue;
+    const pa = entityOfShape(con.shapeIdA) === p, sh = pa ? con.shapeIdB : con.shapeIdA;
+    if (b3.b3Body_GetType(b3.b3Shape_GetBody(sh)) !== b3.b3BodyType.b3_dynamicBody) continue;
+    const e = entityOfShape(sh);
+    if (!e || e.kind !== 'piece' || e === p) return false;
+    const q = e as Piece;
+    if (b3.b3Body_IsAwake(q.body)) return false;
+    /* p lay on q (the manifold normal runs from shape A to shape B: from p down to q), or q touched p and pressed on
+       it with next to nothing (under 5 % of its own weight) when the heap last moved */
+    for (let m = 0; m < con.manifoldCount; m++) {
+      const mf = b3.getManifoldAt(man, con, m);
+      if ((pa ? mf.normal[1] : -mf.normal[1]) < -0.5) continue;
+      let J = 0;
+      for (let k = 0; k < mf.pointCount; k++) J += mf.points[k].totalNormalImpulse;
+      if (J > q.mass * 9.81 / 60 * 0.05) return false;
+    }
+    if (!_quiet.includes(q)) _quiet.push(q);
+  }
+  return _quiet.length > 0;
+}
+/* Box3D splits an island that lost a contact before it sleeps it, so each neighbour's part is put to sleep. */
+function resettle(): void {
+  for (const q of _quiet) if (!q.dead && b3.b3Body_IsValid(q.body) && b3.b3Body_IsAwake(q.body)) b3.b3Body_SetAwake(q.body, false);
+  _quiet.length = 0;
+}
+
 function fadeScale(p: Piece): number {
   return p.fade > 0 ? Math.max(0.02, p.fade / 0.7) : 1;
 }
