{
  "name": "destructovibe",
  "version": "2.0.0",
  "description": "First-person structural demolition game. Three.js + Box3D + math.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-buildings.ts && tsc && vite build",
    "typecheck": "tsc",
    "preview": "vite preview",
    "buildings": "node scripts/gen-buildings.ts",
    "test": "node --test tests/*.test.ts && node tests/fx-impact.mjs",
    "validate:fractures": "node scripts/validate-fractures.ts",
    "validate:levels": "node scripts/validate-levels.ts",
    "validate:grid": "node scripts/validate-grid.ts",
    "validate:rigging": "node scripts/validate-rigging.ts"
  },
  "dependencies": {
    "box3d.js": "^0.1.1",
    "math": "^0.1.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RasputinKaiser/Destructovibe.git"
  }
}
